# Baza de date MySQL
DB_NAME=tutoring_app
DB_USER=root
DB_PASS=

# Server
PORT=5000
ORIGIN_SITE=http://localhost:5173
SITE_MODE=dev

# Sesiuni și JWT
SESSION_SECRET=
JWT_SECRET=
COOKIE_AGE=18000000

# Google OAuth 2.0
CLIENT_ID=
CLIENT_SECRET=
CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Google Calendar API
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5000/api/google-calendar/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Tutoring App <noreply@tutoringapp.ro>