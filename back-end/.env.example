# Baza de date MySQL
DB_NAME=tutoring_app
DB_USER=root
DB_PASS=

# Server
PORT=5000
ORIGIN_SITE=http://localhost:5173
SITE_MODE=dev

# Sesiuni și JWT
SESSION_SECRET=
JWT_SECRET=
COOKIE_AGE=18000000

# Google OAuth 2.0
CLIENT_ID=
CLIENT_SECRET=
CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Google Calendar API
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5000/api/google-calendar/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Scheduler Google Calendar
GOOGLE_CALENDAR_SYNC_CRON=* * * * *
GOOGLE_CALENDAR_MAX_CONCURRENCY=2
GOOGLE_CALENDAR_USER_SYNC_TIMEOUT_MS=30000
GOOGLE_CALENDAR_CYCLE_STALE_MS=600000

# App Drive (read-only, fara conectare user)
GOOGLE_APP_DRIVE_ENABLED=false
GOOGLE_APP_DRIVE_ROOT_FOLDER_ID=
GOOGLE_APP_DRIVE_AUTO_CREATE_CONSULTATION_FOLDERS=true
GOOGLE_APP_DRIVE_SERVICE_ACCOUNT_FILE=
GOOGLE_APP_DRIVE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_APP_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Alternativ, JSON complet service account (escape-uit pe o singura linie)
GOOGLE_APP_DRIVE_SERVICE_ACCOUNT_JSON=

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Tutoring App <noreply@tutoringapp.ro>
# Scheduler notificări
REMINDER_MAX_CONCURRENCY=3
EMAIL_SEND_TIMEOUT_MS=20000
REMINDER_CYCLE_STALE_MS=600000